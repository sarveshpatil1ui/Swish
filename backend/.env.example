# ─── Swish Backend — Environment Variables ────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins (beyond the hardcoded Firebase URLs)
# For local dev: CLIENT_ORIGIN=http://localhost:5173
# For production: leave empty (Firebase URLs are hardcoded) or add custom domains
CLIENT_ORIGIN=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use SRV connection string (recommended):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/swish?retryWrites=true&w=majority
# Or direct seed list (if SRV DNS unavailable on local network):
MONGO_URI=mongodb://127.0.0.1:27017/swish

# ── JWT ───────────────────────────────────────────────────────────────────────
# MUST be a cryptographically random string of at least 64 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5



# 2. Brevo HTTP API (Alternative HTTP API over port 443)
# BREVO_API_KEY=xkeysib-...

# 3. SMTP (For local development on localhost)
# Must use a Gmail App Password (not your regular password).
# How to create: https://support.google.com/accounts/answer/185833
# If not set, OTPs will be logged to the console (dev fallback).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM="Swish Campus 🎓 <noreply@swish.com>"

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Required for college proof document uploads and post media storage.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
# CLOUDINARY_POSTS_FOLDER=swish/posts  # Optional: defaults to 'swish/posts'
# CLOUDINARY_STORIES_FOLDER=swish/stories  # Optional: defaults to 'swish/stories'

# ── Admin ─────────────────────────────────────────────────────────────────────
# Optional: override the default admin password for admin@swish.com
# ADMIN_PASSWORD=SwishAdmin@2026
