# ─────────────────────────────────────────────────────────────────────────────
# SWISH BACKEND — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env:
#   cp .env.example .env
# Fill in real values for your environment. NEVER commit .env to source control.
#
# Reference documentation:
#   • Gmail API OAuth 2.0: backend/docs/gmail-api-setup.md
#   • QA Test Cases: docs/QA_TEST_CASES.md
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Server & Environment ──────────────────────────────────────────────────
# Port the Express server listens on (default: 3001)
PORT=3001

# Runtime environment: 'development' | 'production' | 'test'
# Controls cookie security (SameSite, Secure), Master OTP, and error detail
NODE_ENV=development

# ── 2. CORS & Client Origins ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (Express & Socket.IO)
# Localhost and production Firebase domains are always permitted by default.
CLIENT_ORIGIN=http://localhost:5173

# ── 3. Database Connection ───────────────────────────────────────────────────
# MongoDB connection URI (local MongoDB or MongoDB Atlas replica set)
MONGO_URI=mongodb://127.0.0.1:27017/swish

# ── 4. Authentication & JWT ───────────────────────────────────────────────────
# Secret key used for signing and verifying JSON Web Tokens (JWT)
# REQUIRED: Generate a secure random string (at least 64 characters recommended)
# e.g., run in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-jwt-secret-at-least-64-characters-long

# JWT token expiration time (default: 7d)
JWT_EXPIRES_IN=7d

# ── 5. OTP Security & Verification ───────────────────────────────────────────
# OTP validity duration in minutes (default: 10)
OTP_EXPIRES_MINUTES=10

# Maximum failed verification attempts before lockout (default: 5)
OTP_MAX_ATTEMPTS=5

# Cooldown window between resend-OTP requests in seconds (default: 60)
OTP_RESEND_COOLDOWN_S=60

# Master OTP (DEVELOPMENT ONLY)
# Provides a static bypass code for local development and testing.
# STRICTLY BLOCKED in production (throws 401 if attempted when NODE_ENV=production).
MASTER_OTP=123456

# ── 6. Email Delivery via Google Gmail API (OAuth 2.0) ───────────────────────
# Transactional emails (OTPs, admin invites) are sent via Google Gmail REST API
# over HTTPS (port 443). No SMTP, Resend, Brevo, or Mailgun used.
# See backend/docs/gmail-api-setup.md for step-by-step OAuth configuration.
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_SENDER_EMAIL=your-dedicated-gmail-address
GMAIL_SENDER_NAME="Swish Campus"
GMAIL_REQUEST_TIMEOUT_MS=12000

# ── 7. Cloudinary Media Storage ──────────────────────────────────────────────
# Cloudinary credentials for post media, stories, user avatars, and proof docs.
# Leave blank in development if media uploads are not being tested.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional Cloudinary folder names (defaults shown)
CLOUDINARY_POSTS_FOLDER=swish/posts
CLOUDINARY_STORIES_FOLDER=swish/stories
CLOUDINARY_AVATARS_FOLDER=swish/avatars

# ── 8. Administrator Development Override ─────────────────────────────────────
# Default administrator login password override (DEVELOPMENT ONLY)
# Used by POST /api/auth/admin/login in non-production environments.
ADMIN_PASSWORD=SwishAdmin@2026

# ── 9. Integrations Not Used by Swish ─────────────────────────────────────────
# NOTE: Swish does NOT use Redis, background queue workers, Razorpay, or Stripe.
# All real-time features run via Socket.IO directly on the Express HTTP server.