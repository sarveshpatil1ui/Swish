# Frontend environment variables
# Vite exposes only variables prefixed with VITE_ to the client bundle
#
# Create two files for automatic dev/prod switching:
#   .env.development  → VITE_API_URL=http://localhost:3001
#   .env.production   → VITE_API_URL=https://your-backend.onrender.com
#
# Vite automatically picks the right file based on the mode.
VITE_API_URL=http://localhost:3001
